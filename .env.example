# SidWeave Configuration
# Copy this file to .env and modify as needed

# Runtime
SIDWEAVE_LOG_LEVEL=INFO
SIDWEAVE_ENVIRONMENT=development
SIDWEAVE_DEBUG=false

# Server
SIDWEAVE_SERVER_HOST=127.0.0.1
SIDWEAVE_SERVER_PORT=8080
SIDWEAVE_SERVER_WORKERS=1
SIDWEAVE_SERVER_RELOAD=false
SIDWEAVE_SERVER_LOG_LEVEL=info

# Data Directory (defaults to ~/.sidweave)
SIDWEAVE_STORAGE_DATA_DIR=
SIDWEAVE_STORAGE_DB_FILENAME=sidweave.db
SIDWEAVE_STORAGE_ENABLE_WAL=true

# Ollama (Local Models)
SIDWEAVE_PROVIDER_OLLAMA_HOST=http://localhost:11434
SIDWEAVE_PROVIDER_OLLAMA_TIMEOUT=30
SIDWEAVE_PROVIDER_OLLAMA_KEEP_ALIVE=5m

# Cloud Providers (via LiteLLM)
SIDWEAVE_PROVIDER_ENABLE_CLOUD=false
SIDWEAVE_PROVIDER_LITELLM_MASTER_KEY=
SIDWEAVE_PROVIDER_LITELLM_BASE_URL=
SIDWEAVE_PROVIDER_PREFER_LOCAL=true
SIDWEAVE_PROVIDER_FALLBACK_TO_CLOUD=true

# Routing
SIDWEAVE_ROUTING_DEFAULT_STRATEGY=balanced
SIDWEAVE_ROUTING_ENABLE_LEARNING=true
SIDWEAVE_ROUTING_MIN_SAMPLES_FOR_LEARNING=10
SIDWEAVE_ROUTING_MAX_LATENCY_MS=
SIDWEAVE_ROUTING_MAX_COST_PER_1K_TOKENS=
SIDWEAVE_ROUTING_MAX_FALLBACK_ATTEMPTS=3
SIDWEAVE_ROUTING_FALLBACK_ON_ERROR=true

# Execution (MCP)
SIDWEAVE_EXECUTION_MCP_SERVERS=
SIDWEAVE_EXECUTION_MCP_TIMEOUT=30
SIDWEAVE_EXECUTION_REQUIRE_PRECONDITIONS=true
SIDWEAVE_EXECUTION_REQUIRE_POSTCONDITIONS=true
SIDWEAVE_EXECUTION_ENABLE_IDEMPOTENCY=true
SIDWEAVE_EXECUTION_MAX_RETRY_ATTEMPTS=2
SIDWEAVE_EXECUTION_RETRY_ON_TRANSIENT=true
SIDWEAVE_EXECUTION_REQUIRE_APPROVAL_FOR=

# Telemetry (OpenTelemetry)
SIDWEAVE_TELEMETRY_ENABLED=true
SIDWEAVE_TELEMETRY_SERVICE_NAME=sidweave
SIDWEAVE_TELEMETRY_OTEL_ENDPOINT=
SIDWEAVE_TELEMETRY_SAMPLE_RATE=1.0
SIDWEAVE_TELEMETRY_EXPORT_INTERVAL_MS=5000

# Hardware Detection
SIDWEAVE_HARDWARE_ENABLE_GPU_DETECTION=true
SIDWEAVE_HARDWARE_GPU_DETECTION_TIMEOUT=5.0
SIDWEAVE_HARDWARE_PROFILE_WARMUP_RUNS=2
SIDWEAVE_HARDWARE_PROFILE_MEASUREMENT_RUNS=5
SIDWEAVE_HARDWARE_PROFILE_TIMEOUT=60