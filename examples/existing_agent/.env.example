# SidWeave Existing Agent Example Configuration
# Copy to .env and modify as needed

# SidWeave API endpoint (default: local server)
SIDWEAVE_BASE_URL=http://127.0.0.1:8765/v1

# API key (not needed for local-only usage)
# For cloud providers, SidWeave reads keys from its own config (~/.sidweave/.env)
SIDWEAVE_API_KEY=not-needed